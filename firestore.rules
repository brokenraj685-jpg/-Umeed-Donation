rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isAdmin() || resource.data.status == "verified";
      allow create: if request.resource.data.keys().hasOnly(["name","state","amount","transactionId","note","certificateCode","status","createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.state is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() > 0
        && request.resource.data.certificateCode is string
        && request.resource.data.certificateCode.matches("^[0-9]{6}$")
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}