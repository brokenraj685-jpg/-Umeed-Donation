rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "rajbabushaikh18@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donations/{donationId} {
      allow read: if isAdmin() || resource.data.status == "verified";
      allow create: if request.resource.data.keys().hasOnly(["name","state","amount","transactionId","note","referralCode","certificateCode","status","createdAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.state is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.transactionId is string
        && request.resource.data.transactionId.size() <= 120
        && request.resource.data.certificateCode is string
        && request.resource.data.certificateCode.matches("^[0-9]{6}$")
        && (!("referralCode" in request.resource.data)
          || (request.resource.data.referralCode is string
            && exists(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode))
            && get(/databases/$(database)/documents/referralCodes/$(request.resource.data.referralCode)).data.memberUid is string))
        && request.resource.data.status == "pending";
      allow update, delete: if isAdmin();
    }
    match /certificateCodes/{code} {
      allow get: if resource != null
        && exists(/databases/$(database)/documents/donations/$(resource.data.donationId))
        && get(/databases/$(database)/documents/donations/$(resource.data.donationId)).data.status == "verified";
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/certificateCodes/$(code))
        && request.resource.data.keys().hasOnly(["donationId"])
        && request.resource.data.donationId is string
        && getAfter(/databases/$(database)/documents/donations/$(request.resource.data.donationId)).data.certificateCode == code;
      allow update, delete: if false;
    }
    match /communityJoins/{joinId} {
      allow create: if (!signedIn() || isAdmin())
        && request.resource.data.keys().hasOnly(["name","email","mobile","state","age","status","createdAt","termsAccepted"])
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.mobile is string && request.resource.data.mobile.matches("^[6-9][0-9]{9}$")
        && request.resource.data.state is string && request.resource.data.state.size() > 0
        && request.resource.data.age is int && request.resource.data.age >= 18 && request.resource.data.age <= 100
        && request.resource.data.status == "pending" && request.resource.data.termsAccepted == true;
      allow get: if isAdmin() || (signedIn() && request.auth.uid == joinId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /helpRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(["message","address","mobile","status","createdAt"])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 1500
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 500
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches("^[6-9][0-9]{9}$")
        && request.resource.data.status == "new";
      allow read, update, delete: if isAdmin();
    }
    match /memberPayments/{paymentId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}